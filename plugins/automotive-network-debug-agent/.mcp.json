{
  "mcpServers": {
    "automotive-trace": {
      "cwd": ".",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "./scripts/run_trace_mcp.ps1"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 60,
      "default_tools_approval_mode": "writes"
    }
  }
}
