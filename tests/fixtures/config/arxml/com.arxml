<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ActiveEcuC</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>Com</SHORT-NAME>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>RxGroup</SHORT-NAME>
              <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPduGroup</DEFINITION-REF>
              <PARAMETER-VALUES><ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPduGroup/ComIPduGroupHandleId</DEFINITION-REF><VALUE>1</VALUE></ECUC-NUMERICAL-PARAM-VALUE></PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>TxGroup</SHORT-NAME>
              <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPduGroup</DEFINITION-REF>
              <PARAMETER-VALUES><ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPduGroup/ComIPduGroupHandleId</DEFINITION-REF><VALUE>2</VALUE></ECUC-NUMERICAL-PARAM-VALUE></PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>VehicleSpeed_Rx</SHORT-NAME>
              <LONG-NAME><L-4 L="FOR-ALL">VehicleSpeed</L-4></LONG-NAME>
              <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal/ComBitPosition</DEFINITION-REF><VALUE>8</VALUE></ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal/ComBitSize</DEFINITION-REF><VALUE>16</VALUE></ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal/ComSignalInitValue</DEFINITION-REF><VALUE>0</VALUE></ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal/ComRxDataTimeoutAction</DEFINITION-REF><VALUE>REPLACE</VALUE></ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal/ComRxDataTimeoutSubstitutionValue</DEFINITION-REF><VALUE>65535</VALUE></ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal/ComTimeout</DEFINITION-REF><VALUE>0.5</VALUE></ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>VehicleSpeed_Tx</SHORT-NAME>
              <LONG-NAME><L-4 L="FOR-ALL">VehicleSpeed</L-4></LONG-NAME>
              <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal/ComBitPosition</DEFINITION-REF><VALUE>0</VALUE></ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComSignal/ComTransferProperty</DEFINITION-REF><VALUE>TRIGGERED_ON_CHANGE</VALUE></ECUC-TEXTUAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ComPdu_534_Rx</SHORT-NAME>
              <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu</DEFINITION-REF>
              <PARAMETER-VALUES><ECUC-TEXTUAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComIPduDirection</DEFINITION-REF><VALUE>RECEIVE</VALUE></ECUC-TEXTUAL-PARAM-VALUE></PARAMETER-VALUES>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComIPduGroupRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/Com/RxGroup</VALUE-REF></ECUC-REFERENCE-VALUE>
                <ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComIPduSignalRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/Com/VehicleSpeed_Rx</VALUE-REF></ECUC-REFERENCE-VALUE>
                <ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComPduIdRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/EcuC/Pdu_534_Rx</VALUE-REF></ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ComPdu_534_Tx</SHORT-NAME>
              <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu</DEFINITION-REF>
              <PARAMETER-VALUES><ECUC-TEXTUAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComIPduDirection</DEFINITION-REF><VALUE>SEND</VALUE></ECUC-TEXTUAL-PARAM-VALUE></PARAMETER-VALUES>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComIPduGroupRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/Com/TxGroup</VALUE-REF></ECUC-REFERENCE-VALUE>
                <ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComIPduSignalRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/Com/VehicleSpeed_Tx</VALUE-REF></ECUC-REFERENCE-VALUE>
                <ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComPduIdRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/EcuC/Pdu_534_Tx</VALUE-REF></ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
              <SUB-CONTAINERS>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>ComTxIPdu</SHORT-NAME>
                  <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComTxIPdu</DEFINITION-REF>
                  <PARAMETER-VALUES><ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComTxIPdu/ComMinimumDelayTime</DEFINITION-REF><VALUE>0.005</VALUE></ECUC-NUMERICAL-PARAM-VALUE></PARAMETER-VALUES>
                  <SUB-CONTAINERS>
                    <ECUC-CONTAINER-VALUE>
                      <SHORT-NAME>ComTxModeTrue</SHORT-NAME>
                      <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComTxIPdu/ComTxModeTrue</DEFINITION-REF>
                      <SUB-CONTAINERS>
                        <ECUC-CONTAINER-VALUE>
                          <SHORT-NAME>ComTxMode</SHORT-NAME>
                          <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComTxIPdu/ComTxModeTrue/ComTxMode</DEFINITION-REF>
                          <PARAMETER-VALUES>
                            <ECUC-TEXTUAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComTxIPdu/ComTxModeTrue/ComTxMode/ComTxModeMode</DEFINITION-REF><VALUE>PERIODIC</VALUE></ECUC-TEXTUAL-PARAM-VALUE>
                            <ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComIPdu/ComTxIPdu/ComTxModeTrue/ComTxMode/ComTxModeTimePeriod</DEFINITION-REF><VALUE>0.02</VALUE></ECUC-NUMERICAL-PARAM-VALUE>
                          </PARAMETER-VALUES>
                        </ECUC-CONTAINER-VALUE>
                      </SUB-CONTAINERS>
                    </ECUC-CONTAINER-VALUE>
                  </SUB-CONTAINERS>
                </ECUC-CONTAINER-VALUE>
              </SUB-CONTAINERS>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>VehicleSpeed_GW</SHORT-NAME>
              <DEFINITION-REF>/MICROSAR/Com/ComConfig/ComGwMapping</DEFINITION-REF>
              <SUB-CONTAINERS>
                <ECUC-CONTAINER-VALUE><SHORT-NAME>ComGwSource</SHORT-NAME><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComGwMapping/ComGwSource</DEFINITION-REF><SUB-CONTAINERS><ECUC-CONTAINER-VALUE><SHORT-NAME>ComGwSignal</SHORT-NAME><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComGwMapping/ComGwSource/ComGwSignal</DEFINITION-REF><REFERENCE-VALUES><ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComGwMapping/ComGwSource/ComGwSignal/ComGwSignalRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/Com/VehicleSpeed_Rx</VALUE-REF></ECUC-REFERENCE-VALUE></REFERENCE-VALUES></ECUC-CONTAINER-VALUE></SUB-CONTAINERS></ECUC-CONTAINER-VALUE>
                <ECUC-CONTAINER-VALUE><SHORT-NAME>ComGwDestination</SHORT-NAME><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComGwMapping/ComGwDestination</DEFINITION-REF><SUB-CONTAINERS><ECUC-CONTAINER-VALUE><SHORT-NAME>ComGwSignal</SHORT-NAME><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComGwMapping/ComGwDestination/ComGwSignal</DEFINITION-REF><REFERENCE-VALUES><ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/Com/ComConfig/ComGwMapping/ComGwDestination/ComGwSignal/ComGwSignalRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/Com/VehicleSpeed_Tx</VALUE-REF></ECUC-REFERENCE-VALUE></REFERENCE-VALUES></ECUC-CONTAINER-VALUE></SUB-CONTAINERS></ECUC-CONTAINER-VALUE>
              </SUB-CONTAINERS>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>Start_TxGroup</SHORT-NAME>
              <DEFINITION-REF>/MICROSAR/BswM/BswMConfig/BswMComPduGroupSwitch</DEFINITION-REF>
              <PARAMETER-VALUES><ECUC-TEXTUAL-PARAM-VALUE><DEFINITION-REF>/MICROSAR/BswM/BswMConfig/BswMComPduGroupSwitch/BswMComPduGroupSwitchAction</DEFINITION-REF><VALUE>START</VALUE></ECUC-TEXTUAL-PARAM-VALUE></PARAMETER-VALUES>
              <REFERENCE-VALUES><ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/BswM/BswMConfig/BswMComPduGroupSwitch/BswMComPduGroupSwitchIPduGroupRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/Com/TxGroup</VALUE-REF></ECUC-REFERENCE-VALUE></REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ComM_TxGroup_Link</SHORT-NAME>
              <DEFINITION-REF>/MICROSAR/ComM/ComMConfigSet/ComMChannel</DEFINITION-REF>
              <REFERENCE-VALUES><ECUC-REFERENCE-VALUE><DEFINITION-REF>/MICROSAR/ComM/ComMConfigSet/ComMChannel/ComMIPduGroupRef</DEFINITION-REF><VALUE-REF>/ActiveEcuC/Com/TxGroup</VALUE-REF></ECUC-REFERENCE-VALUE></REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
