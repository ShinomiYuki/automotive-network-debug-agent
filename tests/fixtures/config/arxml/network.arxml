<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Network</SHORT-NAME>
      <ELEMENTS>
        <I-SIGNAL-I-PDU><SHORT-NAME>IPdu_416_SU</SHORT-NAME><LENGTH>8</LENGTH></I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU><SHORT-NAME>IPdu_416_IC</SHORT-NAME><LENGTH>8</LENGTH></I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU><SHORT-NAME>IPdu_416_GL</SHORT-NAME><LENGTH>8</LENGTH></I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU><SHORT-NAME>IPdu_500_SU</SHORT-NAME><LENGTH>8</LENGTH></I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU><SHORT-NAME>IPdu_500_IC</SHORT-NAME><LENGTH>8</LENGTH></I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU><SHORT-NAME>IPdu_600_SU</SHORT-NAME><LENGTH>8</LENGTH></I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU><SHORT-NAME>IPdu_700_SU</SHORT-NAME><LENGTH>8</LENGTH></I-SIGNAL-I-PDU>

        <CAN-FRAME>
          <SHORT-NAME>CanFrame_416</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>Map_416_SU</SHORT-NAME>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_416_SU</PDU-REF>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>CanFrame_500</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING><SHORT-NAME>Map_500_SU</SHORT-NAME><PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_500_SU</PDU-REF></PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>CanFrame_600</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING><SHORT-NAME>Map_600_SU</SHORT-NAME><PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_600_SU</PDU-REF></PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>CanFrame_700</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING><SHORT-NAME>Map_700_SU</SHORT-NAME><PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_700_SU</PDU-REF></PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>

        <CAN-CLUSTER>
          <SHORT-NAME>GatewayCanCluster</SHORT-NAME>
          <CAN-CLUSTER-VARIANTS>
            <CAN-CLUSTER-CONDITIONAL>
              <PHYSICAL-CHANNELS>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>SU</SHORT-NAME>
                  <FRAME-TRIGGERINGS>
                    <CAN-FRAME-TRIGGERING><SHORT-NAME>Trigger_416_SU</SHORT-NAME><IDENTIFIER>0x416</IDENTIFIER><FRAME-REF DEST="CAN-FRAME">/Network/CanFrame_416</FRAME-REF></CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING><SHORT-NAME>Trigger_500_SU</SHORT-NAME><IDENTIFIER>0x500</IDENTIFIER><FRAME-REF DEST="CAN-FRAME">/Network/CanFrame_500</FRAME-REF></CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING><SHORT-NAME>Trigger_600_SU</SHORT-NAME><IDENTIFIER>0x600</IDENTIFIER><FRAME-REF DEST="CAN-FRAME">/Network/CanFrame_600</FRAME-REF></CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING><SHORT-NAME>Trigger_700_SU</SHORT-NAME><IDENTIFIER>0x700</IDENTIFIER><FRAME-REF DEST="CAN-FRAME">/Network/CanFrame_700</FRAME-REF></CAN-FRAME-TRIGGERING>
                  </FRAME-TRIGGERINGS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING><SHORT-NAME>IPdu_416_SU_Trigger</SHORT-NAME><I-PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_416_SU</I-PDU-REF></PDU-TRIGGERING>
                    <PDU-TRIGGERING><SHORT-NAME>IPdu_500_SU_Trigger</SHORT-NAME><I-PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_500_SU</I-PDU-REF></PDU-TRIGGERING>
                    <PDU-TRIGGERING><SHORT-NAME>IPdu_600_SU_Trigger</SHORT-NAME><I-PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_600_SU</I-PDU-REF></PDU-TRIGGERING>
                    <PDU-TRIGGERING><SHORT-NAME>IPdu_700_SU_Trigger</SHORT-NAME><I-PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_700_SU</I-PDU-REF></PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>IC</SHORT-NAME>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING><SHORT-NAME>IPdu_416_IC_Trigger</SHORT-NAME><I-PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_416_IC</I-PDU-REF></PDU-TRIGGERING>
                    <PDU-TRIGGERING><SHORT-NAME>IPdu_500_IC_Trigger</SHORT-NAME><I-PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_500_IC</I-PDU-REF></PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>GL</SHORT-NAME>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING><SHORT-NAME>IPdu_416_GL_Trigger</SHORT-NAME><I-PDU-REF DEST="I-SIGNAL-I-PDU">/Network/IPdu_416_GL</I-PDU-REF></PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
              </PHYSICAL-CHANNELS>
            </CAN-CLUSTER-CONDITIONAL>
          </CAN-CLUSTER-VARIANTS>
        </CAN-CLUSTER>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
